extensions:
    dravencms.partner: Dravencms\Partner\DI\PartnerExtension

services:
    partner.partnerPresenter:
        class: Dravencms\AdminModule\PartnerModule\PartnerPresenter


nettrine.orm:
    managers:
        default:
            mapping:
                DravencmsPartner:
                    type: attributes
                    directories:
                        - %appDir%/../vendor/dravencms/partner/src/Dravencms/Model/Partner/Entities
                    namespace: Dravencms\Model\Partner

files:
    variants:
        partner-main:
            width: 360
            height: 144
            resizeMode: fit_exact
        partner-list:
            width: 261
            height: 144
            resizeMode: fit_exact
        partner-bar:
            width: 100
            height: 100
            resizeMode: fit_exact
